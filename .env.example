# Copy to .env to override the dev database settings; Compose reads .env from the project
# root automatically. .env is gitignored - this file is the tracked documentation of it.
# The defaults below are what docker-compose.yml falls back to, so an absent .env works.

POSTGRES_USER=shortlink
POSTGRES_PASSWORD=shortlink
POSTGRES_DB=shortlink

# Host port only - inside the Compose network the container is always reachable on 5432.
# Change this if a local Postgres install already owns 5432 on the host.
POSTGRES_PORT=5432
