root = true

[*]
charset = utf-8
# LF everywhere, matching .gitattributes. Without this, `dotnet format` on Windows defaults
# to CRLF and reports every file as misformatted - while git rewrites the same files back to
# LF on commit, so the two tools disagree forever.
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown, so trimming them changes rendering.
trim_trailing_whitespace = false

[*.{sln,cmd,ps1}]
end_of_line = crlf
